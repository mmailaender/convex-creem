# ─── Convex ───────────────────────────────────────────────────────────────────
CONVEX_DEPLOYMENT=dev:your-deployment-name
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# ─── Subscription Products — Multi-Cycle (Variant 02) ─────────────────────────
VITE_CREEM_SUB_BASIC_MONTHLY=
VITE_CREEM_SUB_BASIC_QUARTERLY=
VITE_CREEM_SUB_BASIC_SEMI_ANNUAL=
VITE_CREEM_SUB_BASIC_ANNUAL=
VITE_CREEM_SUB_PREMIUM_MONTHLY=
VITE_CREEM_SUB_PREMIUM_QUARTERLY=
VITE_CREEM_SUB_PREMIUM_SEMI_ANNUAL=
VITE_CREEM_SUB_PREMIUM_ANNUAL=

# ─── Subscription Products — Monthly Only (Variants 01, 05) ───────────────────
VITE_CREEM_SUB_SIMPLE_BASIC_MONTHLY=
VITE_CREEM_SUB_SIMPLE_PRO_MONTHLY=

# ─── Subscription Products — Unit-Based (Variants 03, 04, 06) ─────────────────
VITE_CREEM_SUB_UNIT_BASIC_MONTHLY=
VITE_CREEM_SUB_UNIT_PREMIUM_MONTHLY=

# ─── Subscription Products — Period-End Update (Variant 10) ───────────────────
VITE_CREEM_SUB_PERIOD_END_BASIC_MONTHLY=
VITE_CREEM_SUB_PERIOD_END_PREMIUM_MONTHLY=

# ─── One-Time Products (Variants 11, 12, 13) ──────────────────────────────────
